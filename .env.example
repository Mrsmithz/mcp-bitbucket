# Example only. Provide real credentials through your secret manager or MCP host environment.
BITBUCKET_EMAIL=you@example.com
BITBUCKET_API_TOKEN=replace-with-a-Bitbucket-API-token
BITBUCKET_WORKSPACE=your-workspace
# Optional; defaults to https://api.bitbucket.org/2.0
# BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
# Optional; defaults to certificate verification. Set exactly false only for a trusted
# local test/proxy with a certificate you cannot install in the client trust store.
# BITBUCKET_TLS_VERIFY=true
